"use client"

import { Button } from "./ui/button"
import { Card } from "./ui/card"
import { createClientComponentClient } from "@supabase/auth-helpers-nextjs"
import { PartyPopper, Plus, Users, XCircle, MicOff, UserX, Loader2 } from "lucide-react"
import { ConfirmationModal } from './ui/ConfirmationModal'
import Link from "next/link"
import { useEffect, useState, useCallback } from "react"

type Party = {
  id: string
  name: string
  max_players: number
  is_private: boolean
  status: string
  created_at: string
  created_by: string
}

type PartyMemberProfile = {
  username: string | null
  id: string
}

type PartyMember = {
  user_id: string
  profiles: PartyMemberProfile[]
}

export function PartiesSidebar() {
  const [parties, setParties] = useState<Party[]>([])
  const [loading, setLoading] = useState(true)
  const [currentUserId, setCurrentUserId] = useState<string | null>(null)
  const [partyMembers, setPartyMembers] = useState<PartyMember[]>([])
  const [membersLoading, setMembersLoading] = useState(false)
  const [isConfirmModalOpen, setIsConfirmModalOpen] = useState(false)
  const [partyToEndId, setPartyToEndId] = useState<string | null>(null)
  
  const supabase = createClientComponentClient()

  const fetchParties = useCallback(async () => {
    setLoading(true)
    try {
      const { data: { session } } = await supabase.auth.getSession()
      if (session?.user?.id) {
        setCurrentUserId(session.user.id)
        const { data, error } = await supabase
          .from('parties')
          .select('*')
          .eq('created_by', session.user.id)
          .neq('status', 'ended')
          .order('created_at', { ascending: false })

        if (error) throw error
        setParties(data || [])
      } else {
        setParties([])
      }
    } catch (error) {
      console.error('Error fetching parties:', error)
      setParties([])
    } finally {
      setLoading(false)
    }
  }, [supabase])

  useEffect(() => {
    fetchParties()

    const partiesChannel = supabase
      .channel('public:parties')
      .on('postgres_changes', { 
        event: '*', 
        schema: 'public', 
        table: 'parties' 
      }, (payload) => {
        console.log('Parties change received!', payload)
        fetchParties()
      })
      .subscribe()

    return () => {
      supabase.removeChannel(partiesChannel)
    }
  }, [supabase, fetchParties])

  const activeParty = parties.find(p => p.status !== 'ended')

  const fetchPartyMembers = useCallback(async (partyId: string) => {
    if (!partyId) return
    setMembersLoading(true)
    try {
      const { data, error } = await supabase
        .from('party_members')
        .select('user_id, profiles!inner(id, username)')
        .eq('party_id', partyId)
      
      if (error) throw error
      setPartyMembers(data || [])
    } catch (error) {
      console.error('Error fetching party members:', error)
      setPartyMembers([])
    } finally {
      setMembersLoading(false)
    }
  }, [supabase])

  useEffect(() => {
    if (activeParty?.id) {
      fetchPartyMembers(activeParty.id)
      
      const membersChannel = supabase
        .channel(`public:party_members:${activeParty.id}`)
        .on('postgres_changes', {
          event: '*',
          schema: 'public',
          table: 'party_members',
          filter: `party_id=eq.${activeParty.id}`
        }, (payload) => {
          console.log('Party members change received for party', activeParty.id, payload)
          fetchPartyMembers(activeParty.id)
        })
        .subscribe()

      return () => {
        supabase.removeChannel(membersChannel)
      }
    } else {
      setPartyMembers([])
    }
  }, [activeParty, supabase, fetchPartyMembers])

  const handleEndParty = (partyId: string) => {
    setPartyToEndId(partyId)
    setIsConfirmModalOpen(true)
  }

  const confirmEndParty = async () => {
    if (!partyToEndId) return
    try {
      const { error } = await supabase
        .from('parties')
        .update({ status: 'ended' })
        .eq('id', partyToEndId)
      
      if (error) throw error
      await fetchParties()
    } catch (error) {
      console.error('Error ending party:', error)
    } finally {
      setIsConfirmModalOpen(false)
      setPartyToEndId(null)
    }
  }

  const handleKickMember = async (userId: string) => {
    if (!activeParty) return
    try {
      const { error } = await supabase
        .from('party_members')
        .delete()
        .eq('party_id', activeParty.id)
        .eq('user_id', userId)
      
      if (error) throw error
      await fetchPartyMembers(activeParty.id)
    } catch (error) {
      console.error('Error kicking member:', error)
    }
  }

  const handleMuteMember = (userId: string) => {
    console.log(`Mute member ${userId}`)
    // Implement mute functionality
  }

  const isLeader = activeParty && currentUserId === activeParty.created_by

  return (
    <div className="w-80 flex-shrink-0 bg-gray-900/50 border-l border-white/10 p-4 overflow-y-auto" style={{ maxHeight: 'calc(100vh - 4rem)' }}>
      <div className="flex justify-between items-center mb-6">
        <h2 className="text-xl font-bold text-white flex items-center gap-2">
          <PartyPopper className="h-5 w-5 text-pink-400" />
          Your Party
        </h2>
        {!loading && !activeParty && (
          <Link href="/dashboard/create-party">
            <Button size="sm" className="h-8 px-3 bg-pink-600 hover:bg-pink-700">
              <Plus className="h-4 w-4 mr-1" /> New Party
            </Button>
          </Link>
        )}
      </div>

      {loading ? (
        <div className="space-y-4">
          {[1, 2, 3].map((i) => (
            <div key={i} className="h-20 bg-gray-800/50 rounded-lg animate-pulse"></div>
          ))}
        </div>
      ) : activeParty ? (
        <div className="space-y-4">
          <Card className="p-4 bg-gray-800/50 border-gray-700">
            <div className="flex justify-between items-start mb-2">
              <div>
                <h3 className="font-medium text-white">{activeParty.name}</h3>
                <p className="text-xs text-gray-400">
                  {partyMembers.length} {partyMembers.length === 1 ? 'member' : 'members'} • {activeParty.is_private ? 'Private' : 'Public'}
                </p>
              </div>
              {isLeader && (
                <Button 
                  variant="ghost" 
                  size="sm" 
                  className="text-red-400 hover:bg-red-900/20 hover:text-red-300"
                  onClick={() => handleEndParty(activeParty.id)}
                >
                  <XCircle className="h-4 w-4 mr-1" /> End Party
                </Button>
              )}
            </div>

            <div className="mt-4 space-y-2">
              <h4 className="text-xs font-medium text-gray-400 uppercase tracking-wider">Members</h4>
              {membersLoading ? (
                <div className="flex justify-center py-4">
                  <Loader2 className="h-5 w-5 animate-spin text-gray-400" />
                </div>
              ) : partyMembers.length > 0 ? (
                <div className="space-y-2">
                  {partyMembers.map((member) => (
                    <div key={member.user_id} className="flex items-center justify-between group">
                      <span className="text-sm text-gray-200">
                        {member.profiles[0]?.username || 'Unknown User'}
                        {member.user_id === activeParty.created_by && (
                          <span className="ml-2 text-xs bg-pink-900/30 text-pink-300 px-2 py-0.5 rounded-full">
                            Leader
                          </span>
                        )}
                      </span>
                      {isLeader && member.user_id !== currentUserId && (
                        <div className="flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity">
                          <Button
                            variant="ghost"
                            size="icon"
                            className="h-6 w-6 text-gray-400 hover:text-white"
                            onClick={() => handleMuteMember(member.user_id)}
                          >
                            <MicOff className="h-3.5 w-3.5" />
                          </Button>
                          <Button
                            variant="ghost"
                            size="icon"
                            className="h-6 w-6 text-red-400 hover:bg-red-900/20 hover:text-red-300"
                            onClick={() => handleKickMember(member.user_id)}
                          >
                            <UserX className="h-3.5 w-3.5" />
                          </Button>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                <p className="text-xs text-gray-500 text-center py-2">No members yet.</p>
              )}
            </div>
          </Card>
        </div>
      ) : (
        <div className="text-center py-8">
          <Users className="h-12 w-12 mx-auto text-gray-500 mb-2" />
          <p className="text-gray-400 mb-4">You're not in a party yet</p>
          <Link href="/dashboard/create-party">
            <Button className="bg-pink-600 hover:bg-pink-700">
              <Plus className="h-4 w-4 mr-2" /> Create Party
            </Button>
          </Link>
        </div>
      )}

      <ConfirmationModal
        isOpen={isConfirmModalOpen}
        onClose={() => {
          setIsConfirmModalOpen(false)
          setPartyToEndId(null)
        }}
        onConfirm={confirmEndParty}
        title="End Party"
        description="Are you sure you want to end this party? This action cannot be undone."
        confirmText="End Party"
        confirmVariant="destructive"
      />
    </div>
  )
}
